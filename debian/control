Package: mcp-server-wazuh
Architecture: all
Depends: ${misc:Depends}, ${python3:Depends},
 python3-mcp (>= 1:2.0.0),
 python3-fastmcp (>= 4.0.0~b1),
Description: stdio MCP server for Wazuh 5
 Model Context Protocol (MCP) server that reads a Wazuh 5 manager
 (agents, groups, cluster, MITRE) and the indexer (events, findings,
 vulnerability state). Restarting agents is hidden unless
 WAZUH_READ_ONLY is set to false.

Package: mcprack-mcp-server-wazuh
Architecture: all
Depends: ${misc:Depends},
 mcprack (>= 1.5.4),
 mcp-server-wazuh (= ${binary:Version}),
Description: Registers Wazuh MCP server into mcprack catalog
 Companion package for mcp-server-wazuh. Installing it registers
 the mcp-server-wazuh binary as an available MCP server in the local
 mcprack instance; removing it unregisters it again.
